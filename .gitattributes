# TriMem's research freeze hashes working-tree bytes.  Keep every textual
# execution input and evidence envelope byte-stable across Windows and Linux.
/.gitattributes text eol=lf
/.gitignore text eol=lf
/alembic.ini text eol=lf
/DEPENDENCY_PROVENANCE.json text eol=lf
/pyproject.toml text eol=lf
/requirements.lock text eol=lf
.github/workflows/*trimem*.yml text eol=lf
configs/trimem_v1/** text eol=lf
docs/TRIMEM_V1_SYSTEM.md text eol=lf
migrations/env.py text eol=lf
migrations/script.py.mako text eol=lf
migrations/sql/*_up.sql text eol=lf
migrations/sql/*_up.sha256 text eol=lf
migrations/versions/*.py text eol=lf
scripts/check_migration_head.py text eol=lf
scripts/postgres_bootstrap.py text eol=lf
scripts/postgres_bootstrap_roles.sql text eol=lf
scripts/run_trimem_replay_e2e.py text eol=lf
scripts/trimem_*.py text eol=lf
/src/enterprise_memory/providers/openai_responses.py text eol=lf
/src/enterprise_memory/providers/__init__.py text eol=lf
/src/enterprise_memory/providers/base.py text eol=lf
/src/enterprise_memory/providers/redaction.py text eol=lf
/src/enterprise_memory/contracts/*.py text eol=lf
/src/enterprise_memory/indexing/*.py text eol=lf
/src/enterprise_memory/persistence/tenant_context.py text eol=lf
/src/enterprise_memory/persistence/__init__.py text eol=lf
/src/enterprise_memory/persistence/postgres/*.py text eol=lf
/src/enterprise_memory/promotion/security_scan.py text eol=lf
/src/enterprise_memory/service/app.py text eol=lf
/src/enterprise_memory/service/__init__.py text eol=lf
/src/enterprise_memory/service/durable.py text eol=lf
/src/enterprise_memory/service/injection.py text eol=lf
/src/enterprise_memory/service/private_view.py text eol=lf
src/enterprise_memory/trimem/** text eol=lf
/tests/openai/test_openai_provider.py text eol=lf
tests/trimem/** text eol=lf
/tests/unit/test_release_hygiene.py text eol=lf
tests/unit/test_trimem_*.py text eol=lf
artifacts/trimem_v1/**/*.json text eol=lf
artifacts/trimem_v1/**/*.ndjson text eol=lf
artifacts/trimem_v1/**/*.sha256 text eol=lf
artifacts/trimem_v1/**/evidence/blobs/** -text
