+def test_Poly_clear_denoms_zero():
+    # Clearing denominators can simplify an EX coefficient to zero.
+    a = (18**Rational(1, 3) - 2**Rational(1, 3)*3**Rational(2, 3))/2
+    for gens in [(x,), (x, y), (x, y, z)]:
+        for convert in [False, True]:
+            coeff, poly = Poly(a, *gens, domain='EX').clear_denoms(
+                convert=convert)
+            zero = Poly(0, *gens, domain='EX')
+            assert coeff == 2
+            assert poly == zero
+            assert poly.is_zero
+            assert poly.as_expr() == 0
+            assert poly.terms_gcd() == ((0,)*len(gens), zero)
+            assert poly.primitive() == (0, zero)
+
+            # Strip leading zeros at every level, preserving nonzero terms.
+            monom = x*gens[-1]
+            f = Poly(a*monom**2 + monom/2, *gens, domain='EX')
+            assert f.clear_denoms(convert=convert) == (
+                2, Poly(monom, *gens, domain='EX'))
+
+
