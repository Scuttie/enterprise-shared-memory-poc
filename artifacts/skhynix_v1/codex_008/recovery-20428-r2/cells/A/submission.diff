+def test_Poly_clear_denoms_zero_coefficients():
+    # Multiplication in EX can simplify a nonzero-looking coefficient to zero.
+    r = Rational(1, 3)
+    denominator = 1 + sqrt(2)
+    coefficient = (18**r - 2**r*3**(2*r))/denominator
+
+    for gens in ((x,), (x, y), (x, y, z)):
+        zero = Poly(0, *gens, domain='EX')
+        for convert in (False, True):
+            coeff, result = Poly(coefficient, *gens, domain='EX').clear_denoms(
+                convert=convert)
+            assert coeff == denominator
+            assert result == zero
+            assert result.is_zero
+            assert result.terms_gcd() == ((0,)*len(gens), zero)
+            assert result.primitive() == (0, zero)
+
+            # Strip leading zeros at both the outer and innermost levels.
+            for gen in gens:
+                poly = Poly(coefficient*gen + 1, *gens, domain='EX')
+                coeff, result = poly.clear_denoms(convert=convert)
+                assert coeff == denominator
+                assert result == Poly(denominator, *gens, domain='EX')
+
+
