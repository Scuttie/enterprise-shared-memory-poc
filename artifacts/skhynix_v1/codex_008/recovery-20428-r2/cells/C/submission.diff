--- a/sympy/polys/tests/test_densearith.py
+++ b/sympy/polys/tests/test_densearith.py
@@ -259,6 +259,37 @@ def test_dmp_exquo_ground():
         f, ZZ(2), 1, ZZ) == dmp_normal([[3], [1], [4]], 1, ZZ)
 
 
+def test_ground_arithmetic_strip():
+    from sympy import symbols
+    from sympy.polys.domains import EX
+
+    a = symbols('a')
+    # This coefficient becomes zero only when arithmetic simplifies it.
+    z = EX((a + 1)**2 - a**2 - 2*a - 1)
+    assert z != EX.zero
+
+    for op in (dup_mul_ground, dup_quo_ground, dup_exquo_ground):
+        c = EX(2)
+        tail = op([EX.one, EX.zero], c, EX)
+        assert op([z], c, EX) == []
+        assert op([z, z, EX.one, EX.zero], c, EX) == tail
+
+    for op in (dmp_mul_ground, dmp_quo_ground, dmp_exquo_ground):
+        c = EX(2)
+        tail = op([[EX.one, EX.zero]], c, 1, EX)
+        assert op([[z]], c, 1, EX) == [[]]
+        assert op([[z], [z, EX.one, EX.zero]], c, 1, EX) == tail
+        assert op([[[z]], [[z]]], c, 2, EX) == [[[]]]
+        assert op([[[z]], [[z], [EX.one, EX.zero]]], c, 2, EX) == [tail]
+
+    assert dup_quo_ground(ZZ.map([1, 1]), ZZ(2), ZZ) == []
+    assert dup_quo_ground(ZZ.map([1, 2, 0]), ZZ(2), ZZ) == ZZ.map([1, 0])
+    assert dmp_quo_ground(ZZ.map([[1], [1]]), ZZ(2), 1, ZZ) == [[]]
+    assert dmp_quo_ground(
+        ZZ.map([[1], [1, 2, 0]]), ZZ(2), 1, ZZ) == ZZ.map([[1, 0]])
+    assert dmp_mul_ground(ZZ.map([[1], [2]]), ZZ.zero, 1, ZZ) == [[]]
+
+
 def test_dup_lshift():
     assert dup_lshift([], 3, ZZ) == []
     assert dup_lshift([1], 3, ZZ) == [1, 0, 0, 0]
