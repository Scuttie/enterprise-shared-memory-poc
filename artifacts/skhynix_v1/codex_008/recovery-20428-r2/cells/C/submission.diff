+def test_Poly_clear_denoms_zero():
+    from sympy import Rational, symbols
+
+    a = symbols('a')
+    third = Rational(1, 3)
+    expr = (12**third - 2**(2*third)*3**third)/a
+    for gens in ((x,), (x, y)):
+        for convert in (False, True):
+            coeff, poly = Poly(expr, *gens, domain=EX).clear_denoms(
+                convert=convert)
+            zero = Poly(0, *gens, domain=EX)
+            assert coeff == a
+            assert poly.rep == zero.rep
+            assert poly.is_zero
+            assert poly.degree() == -oo
+            assert poly.terms_gcd() == ((0,)*len(gens), zero)
+            assert poly.primitive() == (0, zero)
+
