+def test_ProductSet_finite_comparisons():
+    a = FiniteSet(1, 2)
+    product = ProductSet(a, a)
+    explicit = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    assert product.rewrite(FiniteSet) == explicit
+    assert product.is_subset(explicit) is True
+    assert explicit.is_subset(product) is True
+    assert Eq(product, explicit).simplify() is S.true
+    assert Eq(explicit, product).simplify() is S.true
+
+    smaller = FiniteSet((1, 1), (1, 2), (2, 1))
+    larger = explicit | FiniteSet((3, 3))
+    assert product.is_subset(smaller) is False
+    assert product.is_subset(larger) is True
+    assert Eq(product, smaller) is S.false
+    assert Eq(smaller, product) is S.false
+    assert Eq(product, larger) is S.false
+    assert Eq(larger, product) is S.false
+
+    symbolic = ProductSet(FiniteSet(x), FiniteSet(1))
+    assert symbolic.rewrite(FiniteSet) == FiniteSet((x, 1))
+    assert symbolic.is_subset(FiniteSet((y, 1))) is None
+    assert unchanged(Eq, symbolic, FiniteSet((y, 1)))
+    assert symbolic.is_subset(FiniteSet((x, 1))) is True
+
+    nested = ProductSet(ProductSet(FiniteSet(1), a), FiniteSet(3))
+    assert nested.rewrite(FiniteSet) == FiniteSet(((1, 1), 3), ((1, 2), 3))
+    assert ProductSet(a).rewrite(FiniteSet) == FiniteSet((1,), (2,))
+
+    infinite = ProductSet(S.Integers, a)
+    assert infinite.rewrite(FiniteSet) == infinite
+    assert infinite.is_subset(explicit) is False
+    assert Eq(infinite, explicit) is S.false
+
+
