diff --git a/sympy/sets/tests/test_sets.py b/sympy/sets/tests/test_sets.py
index d29a046..6286cca 100644
--- a/sympy/sets/tests/test_sets.py
+++ b/sympy/sets/tests/test_sets.py
@@ -1601,3 +1601,62 @@ def test_issue_20379():
     #https://github.com/sympy/sympy/issues/20379
     x = pi - 3.14159265358979
     assert FiniteSet(x).evalf(2) == FiniteSet(Float('3.23108914886517e-15', 2))
+
+
+def test_ProductSet_finite_comparisons():
+    explicit = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    smaller = FiniteSet((1, 1), (2, 2))
+    larger = explicit | FiniteSet((3, 3))
+    for factor in (FiniteSet(1, 2), Range(1, 3)):
+        product = ProductSet(factor, factor)
+        assert product.rewrite(FiniteSet) == explicit
+        assert product.intersection(explicit) == explicit
+        assert explicit.intersection(product) == explicit
+        for lhs, rhs in ((product, explicit), (explicit, product)):
+            assert lhs.is_subset(rhs) is True
+            assert lhs.is_superset(rhs) is True
+            assert lhs.is_proper_subset(rhs) is False
+            assert lhs.is_proper_superset(rhs) is False
+            assert Eq(lhs, rhs).simplify() is S.true
+            assert Ne(lhs, rhs).simplify() is S.false
+        for lhs, rhs in ((smaller, product), (product, larger)):
+            assert lhs.is_subset(rhs) is True
+            assert rhs.is_subset(lhs) is False
+            assert lhs.is_proper_subset(rhs) is True
+            assert rhs.is_proper_superset(lhs) is True
+            assert lhs.is_proper_superset(rhs) is False
+            assert rhs.is_proper_subset(lhs) is False
+            assert Eq(lhs, rhs).simplify() is S.false
+            assert Eq(rhs, lhs).simplify() is S.false
+        assert product.is_subset(FiniteSet(1, 2)) is False
+        assert product.is_subset(S.EmptySet) is False
+
+
+def test_ProductSet_finite_symbolic():
+    product = ProductSet(FiniteSet(x), FiniteSet(1))
+    explicit = FiniteSet((1, 1))
+    assert product.rewrite(FiniteSet) == FiniteSet((x, 1))
+    for lhs, rhs in ((product, explicit), (explicit, product)):
+        assert lhs.is_subset(rhs) is None
+        assert lhs.is_proper_subset(rhs) is None
+        assert lhs.is_proper_superset(rhs) is None
+        equality = Eq(lhs, rhs)
+        assert equality not in (S.true, S.false)
+        assert equality.simplify() == equality.canonical
+        assert equality.subs(x, 1) is S.true
+        assert equality.subs(x, 2) is S.false
+
+
+def test_ProductSet_rewrite_FiniteSet():
+    assert ProductSet(FiniteSet(1, 2)).rewrite(FiniteSet) == FiniteSet((1,), (2,))
+    nested = ProductSet(ProductSet(FiniteSet(1), FiniteSet(2)), FiniteSet(3))
+    assert nested.rewrite(FiniteSet) == FiniteSet(((1, 2), 3))
+    for factor in (S.Integers, Interval(0, 1), Interval(x, y)):
+        product = ProductSet(factor, FiniteSet(1))
+        assert product.rewrite(FiniteSet) == product
+    n = Symbol('n', integer=True, positive=True)
+    product = ProductSet(Range(n), FiniteSet(1))
+    assert product.rewrite(FiniteSet) == product
+    assert product.is_subset(FiniteSet((0, 1))) is None
+    assert ProductSet(Range(n, n + 2), FiniteSet(1)).rewrite(FiniteSet) == \
+        FiniteSet((n, 1), (n + 1, 1))
