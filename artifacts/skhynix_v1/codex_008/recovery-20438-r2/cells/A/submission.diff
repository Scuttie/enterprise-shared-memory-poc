diff --git a/sympy/sets/tests/test_sets.py b/sympy/sets/tests/test_sets.py
index d29a046..be2dddd 100644
--- a/sympy/sets/tests/test_sets.py
+++ b/sympy/sets/tests/test_sets.py
@@ -618,6 +618,45 @@ def test_ProductSet():
     assert Contains((1, 2), Z2) is S.true
 
 
+def test_ProductSet_finite_subset():
+    a = FiniteSet(1, 2)
+    product = ProductSet(a, a)
+    explicit = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    assert product.intersection(explicit) == explicit.intersection(product)
+    assert product.is_subset(explicit) is True
+    assert explicit.is_subset(product) is True
+    assert product.is_subset(explicit - FiniteSet((2, 2))) is False
+    assert product.is_subset(explicit | FiniteSet((3, 3))) is True
+    assert Eq(product, explicit) is S.true
+    assert Eq(explicit, product) is S.true
+    assert Eq(product, explicit).simplify() is S.true
+    assert Eq(product, explicit - FiniteSet((2, 2))) is S.false
+    assert Eq(product, explicit | FiniteSet((3, 3))) is S.false
+
+    symbolic = ProductSet(FiniteSet(x), a)
+    assert symbolic.is_subset(FiniteSet((x, 1), (x, 2))) is True
+    assert symbolic.is_subset(FiniteSet((1, 1), (1, 2))) is None
+    assert unchanged(Eq, symbolic, FiniteSet((1, 1), (1, 2)))
+    assert ProductSet(S.Integers, a).is_subset(explicit) is False
+    assert Eq(ProductSet(S.Integers, a), explicit) is S.false
+
+
+def test_ProductSet_rewrite_FiniteSet():
+    a = FiniteSet(1, 2)
+    assert ProductSet(a, a).rewrite(FiniteSet) == \
+        FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    assert ProductSet(a).rewrite(FiniteSet) == FiniteSet((1,), (2,))
+    assert ProductSet(FiniteSet(x), a).rewrite(FiniteSet) == \
+        FiniteSet((x, 1), (x, 2))
+    assert ProductSet(ProductSet(a), a).rewrite(FiniteSet) == \
+        FiniteSet(((1,), 1), ((1,), 2), ((2,), 1), ((2,), 2))
+    assert ProductSet().rewrite(FiniteSet) == FiniteSet(())
+    assert ProductSet(a, S.EmptySet).rewrite(FiniteSet) is S.EmptySet
+    assert ProductSet(a, S.Integers).rewrite(FiniteSet) == ProductSet(a, S.Integers)
+    assert ProductSet(a, Interval(x, y)).rewrite(FiniteSet) == \
+        ProductSet(a, Interval(x, y))
+
+
 def test_ProductSet_of_single_arg_is_not_arg():
