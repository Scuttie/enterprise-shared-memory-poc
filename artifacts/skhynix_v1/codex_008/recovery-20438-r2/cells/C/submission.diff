+def test_ProductSet_finite_subset():
+    # Equivalent sets need not have the same representation (issue 20438).
+    a = FiniteSet(1, 2)
+    product = ProductSet(a, a)
+    explicit = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    assert product.intersection(explicit) == explicit.intersection(product)
+    assert product.is_subset(explicit) is True
+    assert explicit.is_subset(product) is True
+    assert product.is_subset(explicit - FiniteSet((2, 2))) is False
+    assert product.is_subset(explicit | FiniteSet((3, 3))) is True
+
+    for lhs, rhs in [(product, explicit), (explicit, product)]:
+        assert Eq(lhs, rhs) is S.true
+        assert Eq(lhs, rhs, evaluate=False).simplify() is S.true
+    assert Eq(product, explicit - FiniteSet((2, 2))) is S.false
+    assert Eq(product, explicit | FiniteSet((3, 3))) is S.false
+    assert Eq(explicit | FiniteSet((3, 3)), product) is S.false
+
+    symbolic = ProductSet(FiniteSet(x), a)
+    assert symbolic.is_subset(FiniteSet((x, 1), (x, 2))) is True
+    assert symbolic.is_subset(explicit) is None
+    assert unchanged(Eq, symbolic, explicit)
+    assert unchanged(Eq, explicit, symbolic)
+    infinite = ProductSet(S.Integers, a)
+    assert infinite.is_subset(explicit) is False
+    assert Eq(infinite, explicit) is S.false
+    assert Eq(explicit, infinite) is S.false
+
+
+def test_ProductSet_rewrite_FiniteSet():
+    a = FiniteSet(1, 2)
+    assert ProductSet(a, a).rewrite(FiniteSet) == FiniteSet(
+        (1, 1), (1, 2), (2, 1), (2, 2))
+    assert ProductSet(a).rewrite(FiniteSet) == FiniteSet((1,), (2,))
+    assert ProductSet(a, FiniteSet(x)).rewrite(FiniteSet) == FiniteSet(
+        (1, x), (2, x))
+    assert ProductSet(ProductSet(a), FiniteSet(3)).rewrite(FiniteSet) == FiniteSet(
+        ((1,), 3), ((2,), 3))
+    assert ProductSet(Range(2), a).rewrite(FiniteSet) == FiniteSet(
+        (0, 1), (0, 2), (1, 1), (1, 2))
+    for product in [ProductSet(S.Integers, a), ProductSet(Interval(0, 1), a),
+            ProductSet(Interval(x, y), a), ProductSet(Range(n), a)]:
+        assert product.rewrite(FiniteSet) == product
+
