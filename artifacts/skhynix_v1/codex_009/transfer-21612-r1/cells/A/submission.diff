+def test_Mul_reciprocal_denominator():
+    # The unevaluated expression produced by nested LaTeX fractions (issue 21612).
+    a, b, c = symbols('a b c')
+    numerator = Mul(a**3 + b, Pow(c, -1, evaluate=False), evaluate=False)
+    denominator = Pow(Pow(c, 2, evaluate=False), -1, evaluate=False)
+    expr = Mul(numerator, Pow(denominator, -1, evaluate=False), evaluate=False)
+    assert str(expr) == '((a**3 + b)/c)/(1/(c**2))'
+    assert (S(str(expr)) - expr).simplify() == 0
+
+    for exponent, expected in [(-1, '1/x'), (-S.Half, '1/sqrt(x)')]:
+        denominator = Pow(x, exponent, evaluate=False)
+        reciprocal = Pow(denominator, -1, evaluate=False)
+        assert str(Mul(y, reciprocal, evaluate=False)) == 'y/(%s)' % expected
+        # A leading identity uses the printer's unevaluated-product branch.
+        assert str(Mul(1, y, reciprocal, evaluate=False)) == '1*y/(%s)' % expected
+
+
 def test_NaN():
