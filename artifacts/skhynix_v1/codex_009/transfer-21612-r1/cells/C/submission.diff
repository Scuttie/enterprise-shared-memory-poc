+def test_Mul_reciprocal_denominator():
+    # The reciprocal of an unevaluated reciprocal must keep its grouping.
+    for denominator, expected in [
+        (Pow(x**2, -1, evaluate=False), '(1/(x**2))'),
+        (Pow(x, -S.Half, evaluate=False), '(1/sqrt(x))'),
+    ]:
+        reciprocal = Pow(denominator, -1, evaluate=False)
+        for numerator in (S.One, y):
+            expr = Mul(numerator, reciprocal, evaluate=False)
+            assert str(expr) == '%s/%s' % (numerator, expected)
+            assert S(str(expr)) == expr.doit()
+
+    # Expression produced by parsing the nested fractions in issue 21612.
+    numerator = Mul(x**3 + y, Pow(z, -1, evaluate=False), evaluate=False)
+    denominator = Pow(Pow(z**2, -1, evaluate=False), -1, evaluate=False)
+    expr = Mul(numerator, denominator, evaluate=False)
+    assert str(expr) == '((x**3 + y)/z)/(1/(z**2))'
+    assert S(str(expr)) == expr.doit()
+
+
 def test_NaN():
