@@ -162,6 +162,25 @@ def test_monomials():
                     x*j**2, x*k**2, x*j*k, x**2*j**2*k**2, x*j*k**2, x**2, x**2*j*k**2
             }
 
+def test_itermonomials_min_total_degree():
+    cubic = {x**3, y**3, z**3, x**2*y, x**2*z, x*y**2,
+             y**2*z, x*z**2, y*z**2, x*y*z}
+    quadratic = {x**2, y**2, z**2, x*y, x*z, y*z}
+    assert set(itermonomials([x, y, z], 3, min_degrees=3)) == cubic
+    assert set(itermonomials([x, y, z], 3, min_degrees=2)) == cubic | quadratic
+
+
+def test_itermonomials_min_total_degree_noncommutative():
+    i, j = symbols('i j', commutative=False)
+    # Exercise both noncommutative and mixed variable lists.
+    for a, b in [(i, j), (x, j)]:
+        quadratic = {a**2, a*b, b*a, b**2}
+        cubic = {a**3, a**2*b, a*b*a, b*a**2,
+                 a*b**2, b*a*b, b**2*a, b**3}
+        assert set(itermonomials([a, b], 3, min_degrees=3)) == cubic
+        assert set(itermonomials([a, b], 3, min_degrees=2)) == cubic | quadratic
+
+
 def test_monomial_count():
