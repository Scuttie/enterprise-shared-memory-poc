+def test_point_evaluate_false():
+    expected = Point2D(1, 2)
+    real_coords = (S.One, S.Half, sqrt(2), pi)
+    imaginary_coords = (I, 2*I, 1 + I)
+    with evaluate(False):
+        assert S('Point2D(Integer(1),Integer(2))') == expected
+        for cls, coords in ((Point2D, real_coords[:2]),
+                            (Point3D, real_coords[:3]),
+                            (Point, real_coords)):
+            assert cls(*coords).args == coords
+            for coord in imaginary_coords:
+                raises(ValueError, lambda: cls(coord, *coords[1:]))
+        assert Point2D(0.5, 0.25).args == (S(0.5), S(0.25))
