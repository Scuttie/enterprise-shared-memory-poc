+def test_point_evaluate_false():
+    expected = Point2D(1, 2)
+    real_coords = (S.One, S.Half, sqrt(2), S(0.5), Symbol('x'))
+    complex_coords = (I, 2*I, 1 + I)
+    with evaluate(False):
+        assert sympify('Point2D(Integer(1),Integer(2))') == expected
+        for point_type, dimension in ((Point2D, 2), (Point3D, 3), (Point, 4)):
+            for coordinate in real_coords:
+                coords = (coordinate,) + (S.Zero,)*(dimension - 1)
+                assert point_type(*coords).args == coords
+            for coordinate in complex_coords:
+                with raises(ValueError):
+                    point_type(coordinate, *([0]*(dimension - 1)))
+        # The validation should not evaluate the stored coordinates.
+        coordinate = S.One + S.One
+        assert Point2D(coordinate, 0).x == coordinate
+
