+def test_relational_evaluate_false():
+    from sympy.core.relational import Eq, Ne, Lt, Le, Gt, Ge
+
+    for operator, relational in [
+        ('==', Eq), ('!=', Ne), ('<', Lt), ('<=', Le), ('>', Gt), ('>=', Ge),
+    ]:
+        for left, right in [(1, 2), (2, 1), (1, 1)]:
+            text = '%s %s %s' % (left, operator, right)
+            expr = parse_expr(text, evaluate=False)
+            assert expr == relational(left, right, evaluate=False)
+            assert expr.args == (left, right)
+            assert parse_expr(text) == relational(left, right)
+
+        x = Symbol('x')
+        assert parse_expr('x %s x' % operator, evaluate=False) == relational(
+            x, x, evaluate=False)
+        assert parse_expr('1 + 2 %s 3 + 4' % operator, evaluate=False) == relational(
+            parse_expr('1 + 2', evaluate=False),
+            parse_expr('3 + 4', evaluate=False), evaluate=False)
+
+    assert parse_expr('(1 < 2) & (3 >= 4)', evaluate=False) == And(
+        Lt(1, 2, evaluate=False), Ge(3, 4, evaluate=False), evaluate=False)
+    raises(ValueError, lambda: parse_expr('1 < 2 < 3', evaluate=False))
+
