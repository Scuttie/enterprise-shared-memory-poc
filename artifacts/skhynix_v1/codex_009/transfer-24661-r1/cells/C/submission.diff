+    def visit_Compare(self, node):
+        relations = {
+            ast.Eq: 'Eq',
+            ast.NotEq: 'Ne',
+            ast.Lt: 'Lt',
+            ast.LtE: 'Le',
+            ast.Gt: 'Gt',
+            ast.GtE: 'Ge',
+        }
+        if any(type(op) not in relations for op in node.ops):
+            return self.generic_visit(node)
+
+        operands = [self.visit(arg) for arg in [node.left] + node.comparators]
+        comparisons = [
+            ast.Call(
+                func=ast.Name(id=relations[type(op)], ctx=ast.Load()),
+                args=[left, right],
+                keywords=[ast.keyword(arg='evaluate', value=ast.Constant(False))],
+            )
+            for left, op, right in zip(operands, node.ops, operands[1:])
+        ]
+        if len(comparisons) == 1:
+            return comparisons[0]
+        # Chained comparisons are the conjunction of adjacent relations.
+        return ast.Call(
+            func=ast.Name(id='And', ctx=ast.Load()),
+            args=comparisons,
+            keywords=[ast.keyword(arg='evaluate', value=ast.Constant(False))],
+        )
+
