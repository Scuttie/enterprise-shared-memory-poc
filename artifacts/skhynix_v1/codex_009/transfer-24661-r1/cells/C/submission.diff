+def test_relational_evaluate_false():
+    from sympy import Add, Eq, Ne, Lt, Le, Gt, Ge
+
+    x = Symbol('x')
+    for op, relation in [
+        ('==', Eq), ('!=', Ne), ('<', Lt), ('<=', Le),
+        ('>', Gt), ('>=', Ge),
+    ]:
+        for left, right in [(1, 2), (2, 1), (1, 1), (1, x), (x, x)]:
+            text = '%s %s %s' % (left, op, right)
+            assert parse_expr(text, evaluate=False) == relation(
+                left, right, evaluate=False)
+        assert parse_expr('1 + 2 %s 3' % op, evaluate=False) == relation(
+            Add(1, 2, evaluate=False), 3, evaluate=False)
+
+    assert parse_expr('1 < 2') == True
+    assert parse_expr('1 > 2') == False
+    assert parse_expr('[1 < 2]', evaluate=False) == [
+        Lt(1, 2, evaluate=False)]
+    assert parse_expr('(1 < 2) & (2 <= 3)', evaluate=False) == And(
+        Lt(1, 2, evaluate=False), Le(2, 3, evaluate=False),
+        evaluate=False)
+    assert parse_expr('1 < x <= 3', evaluate=False) == And(
+        Lt(1, x, evaluate=False), Le(x, 3, evaluate=False),
+        evaluate=False)
+    assert parse_expr('1 in [1, 2]', evaluate=False) is True
+    assert parse_expr('x is x', evaluate=False) is True
+
