+def test_Poly_clear_denoms_zero():
+    # The coefficient becomes zero only after clearing its denominator.
+    c = 1/(sqrt(2) + sqrt(3)) + sqrt(2) - sqrt(3)
+    for gens in [(x,), (x, y), (x, y, z)]:
+        zero = Poly(0, *gens, domain='EX')
+        for convert in [False, True]:
+            coeff, poly = Poly(c, *gens, domain='EX').clear_denoms(
+                convert=convert)
+            assert coeff == sqrt(2) + sqrt(3)
+            assert poly == zero
+            assert poly.is_zero
+            assert poly.as_expr() == 0
+            assert poly.terms_gcd() == ((0,)*len(gens), zero)
+            assert poly.primitive() == (0, zero)
+
+
