+def test_mul_ground_strip():
+    from sympy import sqrt
+    from sympy.polys.domains import EX
+
+    c = EX(1/(sqrt(2) + sqrt(3)) + sqrt(2) - sqrt(3))
+    assert dup_mul_ground([c], EX(2), EX) == []
+    assert dup_mul_ground([c, EX(1), EX(0)], EX(2), EX) == [EX(2), EX(0)]
+    assert dmp_mul_ground([[c], [c]], EX(2), 1, EX) == [[]]
+    assert dmp_mul_ground([[c], [c, EX(1)]], EX(2), 1, EX) == [[EX(2)]]
+    assert dmp_mul_ground([[[c]], [[c]]], EX(2), 2, EX) == [[[]]]
+    assert dmp_mul_ground([[ZZ(1)], [ZZ(2)]], ZZ(0), 1, ZZ) == [[]]
+
+
