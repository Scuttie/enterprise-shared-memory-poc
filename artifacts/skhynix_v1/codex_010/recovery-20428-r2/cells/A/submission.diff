+def test_Poly_clear_denoms_zero():
+    # Multiplication in EX can simplify a nonzero-looking coefficient to zero.
+    a = 18**Rational(1, 3) - 2**Rational(1, 3)*3**Rational(2, 3)
+    for gens in [(x,), (x, y), (x, y, z)]:
+        zero = Poly(0, *gens, domain=EX)
+        for convert in [False, True]:
+            for term in [1, x, x*gens[-1]]:
+                coeff, poly = Poly(a*term/7, *gens, domain=EX).clear_denoms(
+                    convert=convert)
+                assert coeff == 7
+                assert poly == zero
+                assert poly.is_zero
+                assert poly.as_expr() == 0
+                assert poly.terms_gcd() == ((0,)*len(gens), zero)
+                assert poly.primitive() == (0, zero)
+
+            coeff, poly = Poly(a*x/7 + 1, *gens, domain=EX).clear_denoms(
+                convert=convert)
+            assert coeff == 7
+            assert poly == Poly(7, *gens, domain=EX)
+
+
