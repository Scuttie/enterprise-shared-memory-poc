+def test_Poly_clear_denoms_zero():
+    # Keep an unexpanded coefficient that cancels when denominators clear.
+    c = ((y + 1)**2 - y**2 - 2*y - 1)/2
+    for gens in ((x,), (x, z)):
+        f = Poly.from_dict({(0,)*len(gens): c}, *gens, domain=EX)
+        for convert in (False, True):
+            coeff, poly = f.clear_denoms(convert=convert)
+            zero = Poly(0, *gens, domain=EX)
+            assert coeff == 2
+            assert poly == zero
+            assert poly.rep == zero.rep
+            assert poly.is_zero
