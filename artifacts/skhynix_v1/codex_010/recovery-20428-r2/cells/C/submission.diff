 from sympy.polys.specialpolys import f_polys
-from sympy.polys.domains import FF, ZZ, QQ
+from sympy.polys.domains import EX, FF, ZZ, QQ
+from sympy.abc import a
 
 from sympy.testing.pytest import raises
 
@@ -259,6 +260,40 @@ def test_dmp_exquo_ground():
         f, ZZ(2), 1, ZZ) == dmp_normal([[3], [1], [4]], 1, ZZ)
 
 
+def test_ground_arithmetic_strip():
+    # EX coefficients can become zero only after arithmetic.
+    z = EX((a + 1)**2 - a**2 - 2*a - 1)
+    assert z != EX.zero
+    for operation in (dup_mul_ground, dup_quo_ground, dup_exquo_ground):
+        c = EX(2)
+        tail = operation([EX.one], c, EX)
+        assert operation([z], c, EX) == []
+        assert operation([z, z, EX.one, EX.zero], c, EX) == tail + [EX.zero]
+
+    for operation in (dmp_mul_ground, dmp_quo_ground, dmp_exquo_ground):
+        c = EX(2)
+        tail = operation([[EX.one]], c, 1, EX)
+        assert operation([[z], [z]], c, 1, EX) == [[]]
+        assert operation([[z], [z, EX.one], []], c, 1, EX) == tail + [[]]
+        assert operation([[[z]], [[z]]], c, 2, EX) == [[[]]]
+
+    # Integer quotient can reduce the degree even without simplification.
+    assert dup_quo_ground(ZZ.map([1, 1]), ZZ(2), ZZ) == []
+    assert dup_quo_ground(ZZ.map([1, 3, 0]), ZZ(2), ZZ) == ZZ.map([1, 0])
+    assert dmp_quo_ground(ZZ.map([[1], [1]]), ZZ(2), 1, ZZ) == [[]]
+    assert dmp_quo_ground(
+        ZZ.map([[1], [1, 3], []]), ZZ(2), 1, ZZ) == ZZ.map([[1], []])
+
+
+def test_mul_term_strip():
+    z = EX((a + 1)**2 - a**2 - 2*a - 1)
+    assert dup_mul_term([z], EX(2), 2, EX) == []
+    assert dup_mul_term([z, EX.one], EX(2), 2, EX) == EX.map([2, 0, 0])
+    assert dmp_mul_term([[z]], [EX(2)], 2, 1, EX) == [[]]
+    assert dmp_mul_term(
+        [[z], [EX.one]], [EX(2)], 2, 1, EX) == EX.map([[2], [], []])
+
+
 def test_dup_lshift():
