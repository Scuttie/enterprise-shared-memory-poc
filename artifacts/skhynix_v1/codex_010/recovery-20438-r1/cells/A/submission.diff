+def test_product_finiteset():
+    # issue 20438: equivalent sets need not have the same representation.
+    a = FiniteSet(1, 2)
+    product = ProductSet(a, a)
+    points = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    assert product.intersection(points) == points.intersection(product)
+    assert product.is_subset(points) is True
+    assert points.is_subset(product) is True
+    assert Eq(product, points) is S.true
+    assert Eq(points, product) is S.true
+    assert Eq(product, points, evaluate=False).simplify() is S.true
+    assert Eq(points, product, evaluate=False).simplify() is S.true
+    assert product.rewrite(FiniteSet) == points
+
+    missing = FiniteSet((1, 1), (1, 2), (2, 1))
+    extra = points | FiniteSet((3, 3))
+    assert product.is_subset(missing) is False
+    assert product.is_subset(extra) is True
+    assert Eq(product, missing) is S.false
+    assert Eq(extra, product) is S.false
+
+    symbolic = ProductSet(FiniteSet(x), FiniteSet(1))
+    assert symbolic.rewrite(FiniteSet) == FiniteSet((x, 1))
+    assert symbolic.is_subset(FiniteSet((y, 1))) is None
+    assert unchanged(Eq, symbolic, FiniteSet((y, 1)))
+    assert symbolic.is_subset(FiniteSet((x, 2))) is False
+
+    nested = ProductSet(ProductSet(FiniteSet(1), FiniteSet(2)), a)
+    assert nested.rewrite(FiniteSet) == FiniteSet(((1, 2), 1), ((1, 2), 2))
+    infinite = ProductSet(a, S.Integers)
+    assert infinite.rewrite(FiniteSet) == infinite
+    assert infinite.is_subset(points) is False
+
+
