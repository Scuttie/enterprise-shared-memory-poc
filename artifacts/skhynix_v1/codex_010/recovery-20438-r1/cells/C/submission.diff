diff --git a/sympy/sets/tests/test_sets.py b/sympy/sets/tests/test_sets.py
index d29a046..0bdac5e 100644
--- a/sympy/sets/tests/test_sets.py
+++ b/sympy/sets/tests/test_sets.py
@@ -618,6 +618,64 @@ def test_ProductSet():
     assert Contains((1, 2), Z2) is S.true
 
 
+def test_ProductSet_finite_comparisons():
+    explicit = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    smaller = FiniteSet((1, 1), (2, 2))
+    larger = explicit | FiniteSet((3, 3))
+    for factor in [FiniteSet(1, 2), Range(1, 3)]:
+        product = ProductSet(factor, factor)
+        assert product.rewrite(FiniteSet) == explicit
+        assert product.intersection(explicit) == explicit.intersection(product)
+        for left, right in [(product, explicit), (explicit, product)]:
+            assert left.is_subset(right) is True
+            assert left.is_superset(right) is True
+            assert left.is_proper_subset(right) is False
+            assert left.is_proper_superset(right) is False
+            assert Eq(left, right) is S.true
+            assert Eq(left, right, evaluate=False).simplify() is S.true
+        assert product.is_subset(smaller) is False
+        assert product.is_proper_superset(smaller) is True
+        assert smaller.is_proper_subset(product) is True
+        assert product.is_proper_subset(larger) is True
+        assert larger.is_proper_superset(product) is True
+        assert Eq(product, smaller) is S.false
+        assert Eq(smaller, product) is S.false
+
+    # Subset queries can stop without expanding a large finite product.
+    large = ProductSet(Range(10**100), FiniteSet(1))
+    assert large.is_subset(FiniteSet((0, 1))) is False
+
+    symbolic = ProductSet(FiniteSet(x), FiniteSet(1))
+    explicit = FiniteSet((y, 1))
+    assert symbolic.rewrite(FiniteSet) == FiniteSet((x, 1))
+    for left, right in [(symbolic, explicit), (explicit, symbolic)]:
+        assert left.is_subset(right) is None
+        assert left.is_proper_subset(right) is None
+        assert left.is_proper_superset(right) is None
+        assert unchanged(Eq, left, right)
+        assert Eq(left, right).simplify() == Eq(left, right)
+        assert Eq(left, right).subs(y, x) is S.true
+        assert Eq(left, right).subs(y, x + 1) is S.false
+
+
+def test_ProductSet_rewrite_FiniteSet():
+    assert ProductSet(FiniteSet(1, 2)).rewrite(FiniteSet) == FiniteSet((1,), (2,))
+    nested = ProductSet(ProductSet(FiniteSet(1), FiniteSet(2)), FiniteSet(3))
+    assert nested.rewrite(FiniteSet) == FiniteSet(((1, 2), 3))
+    n = Symbol('n', integer=True, positive=True)
+    symbolic = ProductSet(Range(n, n + 2), FiniteSet(1))
+    assert symbolic.rewrite(FiniteSet) == FiniteSet((n, 1), (n + 1, 1))
+    for product in [
+            ProductSet(S.Integers, FiniteSet(1)),
+            ProductSet(Interval(0, 1), FiniteSet(1)),
+            ProductSet(Interval(x, y), FiniteSet(1)),
+            ProductSet(Range(n), FiniteSet(1))]:
+        assert product.rewrite(FiniteSet) == product
+    infinite = ProductSet(S.Integers, FiniteSet(1))
+    assert infinite.is_subset(FiniteSet((1, 1))) is False
+    assert Eq(infinite, FiniteSet((1, 1))) is S.false
+
