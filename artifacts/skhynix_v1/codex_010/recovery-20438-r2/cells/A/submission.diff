+def test_ProductSet_rewrite_FiniteSet():
+    a = FiniteSet(1, 2)
+    b = ProductSet(a, a)
+    c = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    assert b.rewrite(FiniteSet) == c
+    assert ProductSet(a).rewrite(FiniteSet) == FiniteSet((1,), (2,))
+    assert ProductSet(b, a).rewrite(FiniteSet) == FiniteSet(*ProductSet(c, a))
+    assert ProductSet(Range(2), a).rewrite(FiniteSet) == FiniteSet(
+        (0, 1), (0, 2), (1, 1), (1, 2))
+    assert ProductSet(S.Integers, a).rewrite(FiniteSet) == ProductSet(S.Integers, a)
+    symbolic = ProductSet(Intersection(FiniteSet(1), Interval(0, x)), a)
+    assert symbolic.rewrite(FiniteSet) == symbolic
+
+
+def test_issue_20438():
+    a = FiniteSet(1, 2)
+    b = ProductSet(a, a)
+    c = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    assert b.intersection(c) == c.intersection(b)
+    assert b.is_subset(c) is True
+    assert c.is_subset(b) is True
+    assert Eq(b, c) is S.true
+    assert Eq(c, b) is S.true
+    assert Eq(b, c, evaluate=False).simplify() is S.true
+
+    missing = FiniteSet((1, 1), (1, 2), (2, 1))
+    extra = c | FiniteSet((3, 3))
+    assert b.is_subset(missing) is False
+    assert b.is_subset(extra) is True
+    assert extra.is_subset(b) is False
+    assert Eq(b, missing) is S.false
+    assert Eq(extra, b) is S.false
+    assert b.is_subset(FiniteSet(1, 2)) is False
+    assert Eq(b, FiniteSet(1, 2)) is S.false
+
+    symbolic = ProductSet(FiniteSet(x), FiniteSet(1))
+    point = FiniteSet((1, 1))
+    assert symbolic.is_subset(point) is None
+    assert unchanged(Eq, symbolic, point)
+    assert symbolic.subs(x, 1).is_subset(point) is True
+    assert symbolic.subs(x, 2).is_subset(point) is False
+    infinite = ProductSet(S.Integers, a)
+    assert infinite.is_subset(c) is False
+    assert Eq(infinite, c) is S.false
+    assert Eq(c, infinite) is S.false
+
