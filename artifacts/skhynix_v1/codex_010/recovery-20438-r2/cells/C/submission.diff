+def test_ProductSet_finite_comparisons():
+    explicit = FiniteSet((1, 1), (1, 2), (2, 1), (2, 2))
+    for factor in (FiniteSet(1, 2), Range(1, 3)):
+        product = ProductSet(factor, factor)
+        assert product.rewrite(FiniteSet) == explicit
+        assert product.intersection(explicit) == explicit.intersection(product)
+        for lhs, rhs in ((product, explicit), (explicit, product)):
+            assert lhs.is_subset(rhs) is True
+            assert lhs.is_superset(rhs) is True
+            assert lhs.is_proper_subset(rhs) is False
+            assert lhs.is_proper_superset(rhs) is False
+            assert Eq(lhs, rhs).simplify() is S.true
+
+        smaller = FiniteSet((1, 1))
+        larger = explicit | FiniteSet((3, 3))
+        assert product.is_subset(smaller) is False
+        assert product.is_proper_superset(smaller) is True
+        assert smaller.is_proper_subset(product) is True
+        assert product.is_proper_subset(larger) is True
+        assert larger.is_proper_superset(product) is True
+        assert Eq(product, smaller) is S.false
+        assert Eq(larger, product) is S.false
+
+    symbolic = ProductSet(FiniteSet(x), FiniteSet(1))
+    explicit = FiniteSet((y, 1))
+    assert symbolic.rewrite(FiniteSet) == FiniteSet((x, 1))
+    assert symbolic.is_subset(explicit) is None
+    assert explicit.is_subset(symbolic) is None
+    assert symbolic.is_proper_subset(explicit) is None
+    assert explicit.is_proper_superset(symbolic) is None
+    assert Eq(symbolic, explicit).simplify() == Eq(symbolic, explicit)
+    assert Eq(explicit, symbolic).simplify() == Eq(explicit, symbolic)
+    assert Eq(symbolic, explicit).subs(y, x) is S.true
+    assert Eq(explicit, symbolic).subs(y, x + 1) is S.false
+
+    infinite = ProductSet(S.Integers, FiniteSet(1))
+    assert infinite.rewrite(FiniteSet) == infinite
+    assert infinite.is_subset(FiniteSet((1, 1))) is False
+    assert Eq(infinite, FiniteSet((1, 1))) is S.false
+    continuous = ProductSet(Interval(0, 1), FiniteSet(1))
+    assert continuous.rewrite(FiniteSet) == continuous
+    nested = ProductSet(ProductSet(FiniteSet(1)), FiniteSet(2))
+    assert nested.rewrite(FiniteSet) == FiniteSet(((1,), 2))
+    n = Symbol('n', integer=True, positive=True)
+    unknown = ProductSet(Range(n), FiniteSet(1))
+    assert unknown.rewrite(FiniteSet) == unknown
+
