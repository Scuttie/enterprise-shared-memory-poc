+def test_complement_finite_set_unknown_membership():
+    interval = Interval(-10, 10)
+    unknown = Complement(FiniteSet(x, y), interval, evaluate=False)
+    result = Complement(FiniteSet(x, y, 2), interval)
+    assert result == unknown
+    assert result.subs({x: 0, y: 20}) == FiniteSet(20)
+    assert result.subs({x: 0, y: 1}) == S.EmptySet
+    assert Complement(FiniteSet(x, y, 2, 20), interval) == \
+        Union(FiniteSet(20), unknown)
+    assert Complement(FiniteSet(x, y), interval) == unknown
+    assert Complement(FiniteSet(-10, 2, 10, 20), interval) == FiniteSet(20)
+    assert Complement(FiniteSet(x + 1, 2), interval) == \
+        Complement(FiniteSet(x + 1), interval, evaluate=False)
+
+    positive = Symbol('positive', positive=True)
+    negative = Symbol('negative', negative=True)
+    assert Complement(FiniteSet(positive, negative), Interval(0, oo)) == \
+        FiniteSet(negative)
+    assert Complement(FiniteSet(x, 2, S.Half), S.Integers) == \
+        Union(FiniteSet(S.Half),
+              Complement(FiniteSet(x), S.Integers, evaluate=False))
+
