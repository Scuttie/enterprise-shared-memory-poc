+def test_issue_13615():
+    interval = Interval(-10, 10)
+    unresolved = Complement(FiniteSet(x, y), interval, evaluate=False)
+    result = Complement(FiniteSet(x, y, 2), interval)
+    assert result == unresolved
+    assert result.subs({x: 0, y: 20}) == FiniteSet(20)
+    assert Complement(FiniteSet(x, y, 2, 20), interval) == Union(
+        FiniteSet(20), unresolved)
+    assert Complement(FiniteSet(x, y), interval) == unresolved
+    assert Complement(FiniteSet(2, 20), interval) == FiniteSet(20)
+    assert Complement(FiniteSet(2), interval) == S.EmptySet
+
+    # Expressions and symbolic endpoints also have undecidable membership.
+    assert Complement(FiniteSet(2, x + 1), interval) == Complement(
+        FiniteSet(x + 1), interval, evaluate=False)
+    symbolic_interval = Interval(x, x + 1)
+    assert Complement(FiniteSet(2), symbolic_interval) == Complement(
+        FiniteSet(2), symbolic_interval, evaluate=False)
