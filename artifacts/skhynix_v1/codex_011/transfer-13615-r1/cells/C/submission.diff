     assert all(pt in notsquare for pt in [(-1, 0), (1.5, .5), (10, 10)])
 
 
+def test_complement_finite_set_unknown_membership():
+    interval = Interval(-10, 10)
+    unknown = Complement(FiniteSet(x, y), interval, evaluate=False)
+    assert Complement(FiniteSet(x, y, 2), interval) == unknown
+    assert Complement(FiniteSet(x, y), interval) == unknown
+    assert Complement(FiniteSet(x, y, 2, 20), interval) == Union(
+        FiniteSet(20), unknown)
+    assert Complement(FiniteSet(-10, 2, 10), interval) == S.EmptySet
+    assert Complement(FiniteSet(-20, 2, 20), interval) == FiniteSet(-20, 20)
+    assert Complement(FiniteSet(-10, 2, 10), Interval.open(-10, 10)) == \
+        FiniteSet(-10, 10)
+
+    # Substitution must still exclude symbols that turn out to be inside.
+    result = Complement(FiniteSet(x, y, 2), interval)
+    assert result.subs({x: 2, y: 20}) == FiniteSet(20)
+
+    # Numeric elements can also have undecidable membership.
+    symbolic_interval = Interval(x, 10)
+    assert Complement(FiniteSet(2), symbolic_interval) == Complement(
+        FiniteSet(2), symbolic_interval, evaluate=False)
+    assert Complement(FiniteSet(2, pi, x), S.Integers) == Union(
+        FiniteSet(pi), Complement(FiniteSet(x), S.Integers, evaluate=False))
+
+
