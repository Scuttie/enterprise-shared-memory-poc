+    # issue 15873: nonzero imaginary terms can cancel in an Add.
+    assert (-2*I + (1 + I)**2).is_zero is True
+    assert (I + (1 + I)**2).is_zero is False
+    assert Add(I, -I, evaluate=False).is_zero is True
+    a, b = symbols('a b', imaginary=True)
+    assert (a + b).is_zero is None
+    assert (x + a + b).is_zero is None
+    assert (1 + a + b).is_zero is False
