+    # Multiple nonzero imaginary terms can cancel (issue 15873).
+    e = -2*I + (1 + I)**2
+    assert e.expand().is_zero is True
+    assert e.is_zero is not False
+
+    u, v = symbols('u v', imaginary=True)
+    assert (u + v).is_zero is None
+    assert (x + u + v).is_zero is None
+    assert (x + u).is_zero is False
+    assert (1 + u + v).is_zero is False
+    r = Symbol('r', real=True)
+    assert (u + r*I).is_zero is None
