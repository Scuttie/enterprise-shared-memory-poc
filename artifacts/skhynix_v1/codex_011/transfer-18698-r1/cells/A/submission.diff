+def test_sqf_list_equal_multiplicities():
+    f = (x**2 + 1)*(x - 1)**2*(x - 2)**3*(x - 3)**3
+    factors = [(x**2 + 1, 1), (x - 1, 2), (x**2 - 5*x + 6, 3)]
+    assert sqf_list(f) == (1, factors)
+    assert sqf_list(f, x) == sqf_list(f.expand(), x) == (1, factors)
+    assert sqf_list(6*f, polys=True) == (
+        6, [(Poly(g, x), k) for g, k in factors])
+    assert sqf(f) == (x**2 + 1)*(x - 1)**2*(x**2 - 5*x + 6)**3
+
+    g = (x + 1)**2*(x + 2)**2
+    assert sqf_list(f/g, frac=True) == (
+        1, factors, [(x**2 + 3*x + 2, 2)])
+    assert sqf_list((x - 1)*(x + 1)) == (1, [(x**2 - 1, 1)])
+    assert sqf_list((x + 1)**2*(y + 1)**2) == (
+        1, [(x*y + x + y + 1, 2)])
+
+    # Combining bases under unrestricted powers could change their branches.
+    g = sqrt(x - 1)*sqrt(x + 1)
+    assert sqf(g) == g
+    g = (x - 1)**y*(x + 1)**y
+    assert sqf(g) == g
+
