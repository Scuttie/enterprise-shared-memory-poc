--- a/sympy/polys/polytools.py
+++ b/sympy/polys/polytools.py
@@ -5950,6 +5950,21 @@ def _symbolic_factor_list(expr, opt, method):
 
                 factors.append((_factors_product(other), exp))
 
+    if method == 'sqf':
+        # Polynomial factors of the same multiplicity form one square-free
+        # factor. Keep expressions with unrestricted powers separate.
+        grouped = {}
+        other = []
+        for f, k in factors:
+            if f.is_Poly:
+                if k in grouped:
+                    grouped[k] *= f
+                else:
+                    grouped[k] = f
+            else:
+                other.append((f, k))
+        factors = [(f, k) for k, f in grouped.items()] + other
+
     return coeff, factors
 
 
