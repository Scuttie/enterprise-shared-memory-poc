+def test_sqf_list_group_multiplicities():
+    f = (x**2 + 1)*(x - 1)**2*(x - 2)**3*(x - 3)**3
+    factors = [(x**2 + 1, 1), (x - 1, 2), (x**2 - 5*x + 6, 3)]
+    assert sqf_list(f) == (1, factors)
+    assert sqf_list(f) == sqf_list(f.expand())
+    assert sqf_list(f, polys=True) == (1, [(Poly(g, x), k) for g, k in factors])
+    assert sqf(f) == (x**2 + 1)*(x - 1)**2*(x**2 - 5*x + 6)**3
+
+    g = (x + 1)**2*(x + 2)**2
+    assert sqf_list(6*f/g, frac=True) == (6, factors, [(x**2 + 3*x + 2, 2)])
+    assert sqf((x - 2)**3*(y - 3)**3) == (x*y - 3*x - 2*y + 6)**3
+    assert sqf(sqrt(x)*sqrt(y)) == sqrt(x)*sqrt(y)
+    assert factor_list(f) == (1, [(x - 1, 2), (x - 3, 3), (x - 2, 3), (x**2 + 1, 1)])
+
