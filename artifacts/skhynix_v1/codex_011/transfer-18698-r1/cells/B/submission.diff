index c9e77a9..4bbde89 100644
--- a/sympy/polys/polytools.py
+++ b/sympy/polys/polytools.py
@@ -5950,6 +5950,20 @@ def _symbolic_factor_list(expr, opt, method):
 
                 factors.append((_factors_product(other), exp))
 
+    if method == 'sqf':
+        grouped = {}
+        other = []
+        for f, k in factors:
+            # Combining fractional powers can change their principal values.
+            if f.is_Poly and sympify(k).is_integer:
+                if k in grouped:
+                    grouped[k] *= f
+                else:
+                    grouped[k] = f
+            else:
+                other.append((f, k))
+        factors = [(f, k) for k, f in grouped.items()] + other
+
     return coeff, factors
 
 
