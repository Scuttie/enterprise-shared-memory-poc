+def test_subs_CondSet_condition_evaluates():
+    # A true condition selects the entire substituted base set, regardless
+    # of whether the replacement value belongs to that set (issue 19495).
+    condition = Contains(y, Interval(-1, 1))
+    for base in (imageset(Lambda(w, 2*w*pi + asin(y)), S.Integers),
+                 FiniteSet(-y, y), Interval(2, 3), S.Integers):
+        c = ConditionSet(x, condition, base)
+        for value in (Rational(1, 3), S.Zero, -Rational(1, 3)):
+            expected = base.subs(y, value)
+            assert c.subs(y, value) == expected
+            assert c.subs(y, value, simultaneous=True) == expected
+            assert c.xreplace({y: value}) == expected
+        for value in (-2, 2):
+            assert c.subs(y, value) is S.EmptySet
+        assert c.subs(y, z) == ConditionSet(
+            x, Contains(z, Interval(-1, 1)), base.subs(y, z))
