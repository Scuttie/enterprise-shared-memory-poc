+def test_subs_CondSet_condition_true():
+    # A true condition selects the whole base set, even when the
+    # substituted value is not an element of that set.
+    assert ConditionSet(x, y > 0, Interval(-2, -1)).subs(y, 1) == \
+        Interval(-2, -1)
+
+    n = Symbol('n')
+    base = imageset(Lambda(n, 2*n*pi + asin(y)), S.Integers)
+    c = ConditionSet(x, Contains(y, Interval(-1, 1)), base)
+    value = Rational(1, 3)
+    expected = imageset(Lambda(n, 2*n*pi + asin(value)), S.Integers)
+    assert c.subs(y, value) == expected
+    assert c.subs(y, value, simultaneous=True) == expected
+    assert c.xreplace({y: value}) == expected
+    assert c.subs(y, 2) is S.EmptySet
+    assert c.subs(y, z) == ConditionSet(
+        x, Contains(z, Interval(-1, 1)), base.subs(y, z))
+
